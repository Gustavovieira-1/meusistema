<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule ^cadastro(\.html)?$ novocadastro.html [R=301,L]
  RewriteRule ^privacidade/?$ privacidade.html [L]
  RewriteRule ^termos/?$ termos.html [L]
  RewriteRule ^cookies/?$ cookies.html [L]
  RewriteRule ^dados-google/?$ dados-google.html [L]
  RewriteRule ^exclusao-conta/?$ exclusao-conta.html [L]
  RewriteCond %{QUERY_STRING} (^|&)r=
  RewriteRule ^(index\.html)?$ cardapio.html [L]
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(html|htm)$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires "0"
  </FilesMatch>
</IfModule>
